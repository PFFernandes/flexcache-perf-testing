# Optional: copy to terraform.tfvars.

flexcache_name          = "vol_cache"
flexcache_size_gib      = 500 # smaller than the dataset = test eviction; larger = warm-cache reads
flexcache_junction_path = "/vol_cache"
cache_aggregates        = ["aggr1"]

# Default: connect straight to each management IP from 02-fsxn (needs a VPN or
# other route from your Mac into the VPCs). Override only for e.g. a port forward:
# origin_ontap_endpoint = "localhost:8443"
# cache_ontap_endpoint  = "localhost:9443"
