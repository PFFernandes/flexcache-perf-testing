# Optional: copy to terraform.tfvars to override defaults. Regions come from common.tfvars.

origin_vpc_cidr = "10.10.0.0/16"

# AZs come from common.tfvars (origin_azs / cache_azs). Subnet CIDRs are derived
# from them: one private /24 per AZ (x.x.1.0, x.x.2.0, ...) and, when NAT is on,
# one public /24 (x.x.101.0) in the first AZ. Override only if you need other CIDRs:
# origin_private_subnet_cidrs = ["10.10.1.0/24"]
# origin_public_subnet_cidrs  = ["10.10.101.0/24"]
origin_nat_gateway = true

cache_vpc_cidr = "10.20.0.0/16"
# cache_private_subnet_cidrs = ["10.20.1.0/24"]
# cache_public_subnet_cidrs  = ["10.20.101.0/24"]
cache_nat_gateway = true
