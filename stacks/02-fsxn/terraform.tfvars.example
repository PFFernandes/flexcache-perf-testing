# Optional: copy to terraform.tfvars.

# Which side is deployed (Origin, Cache or both) is set in common.tfvars:
# deploy_origin / deploy_cache.

# FSx for ONTAP Origin
origin_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

# FSx for ONTAP Cache
cache_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

origin_volume = {
  name          = "vol_origin"
  size_gib      = 800
  junction_path = "/vol_origin"
}
