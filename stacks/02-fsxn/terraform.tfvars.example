# Optional: copy to terraform.tfvars.

# Step 1: origin only. Step 2: set to true and apply again to add the cache.
enable_cache_fsxn = false

origin_fsxn = {
  deployment_type                 = "SINGLE_AZ_2"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 1536
  ha_pairs                        = 1
}

cache_fsxn = {
  deployment_type                 = "SINGLE_AZ_2"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 1536
  ha_pairs                        = 1
}

origin_volume = {
  name          = "vol_origin"
  size_gib      = 800
  junction_path = "/vol_origin"
}
