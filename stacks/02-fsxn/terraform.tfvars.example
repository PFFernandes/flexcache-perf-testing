# Optional: copy to terraform.tfvars.

# Which side is deployed (Origin, Cache or both) is set in common.tfvars:
# deploy_origin / deploy_cache.

# FSx for ONTAP Origin
origin_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

# FSx for ONTAP Cache
cache_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

# Origin volume: FlexGroup with storage efficiency on. A FlexGroup needs at least
# 100 GiB per constituent (8 constituents by default = 800 GiB minimum).
origin_volume = {
  name                       = "vol_origin"
  size_gib                   = 800
  junction_path              = "/vol_origin"
  volume_style               = "FLEXGROUP"
  storage_efficiency_enabled = true
  # constituents_per_aggregate = 4   # fewer constituents = smaller minimum size (4 x 100 GiB)
}

# protocol = "smb" (common.tfvars) only: SMB server names of the SVMs in the domain.
svm_netbios_names = {
  origin = "origin"
  cache  = "cache"
}
