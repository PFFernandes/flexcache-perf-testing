# Optional: copy to terraform.tfvars.

# Step 1: FSx for ONTAP Origin only. Step 2: set to true and apply again to add the FSx for ONTAP Cache.
enable_cache_fsxn = false

# FSx for ONTAP Origin
origin_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

# FSx for ONTAP Cache
cache_fsxn = {
  deployment_type                 = "SINGLE_AZ_1"
  storage_capacity_gib            = 1024
  throughput_capacity_per_ha_pair = 128
  ha_pairs                        = 1
}

origin_volume = {
  name          = "vol_origin"
  size_gib      = 800
  junction_path = "/vol_origin"
}
