# OpenTelemetry Collector on the ${side} client. Rendered by modules/11-bench-telemetry.
#
# In:  hostmetrics (CPU, memory, load, disk, network, paging) every ${interval_s} s
#      OTLP/HTTP on 127.0.0.1:4318 from bench-probe (NFS, ENA limits, ping)
# Out: files on the client's LOCAL disk, OTLP JSON, one batch per line:
#      ${path}
#      rotated every ${rotate_mib} MiB to metrics-<time>.json, at most ${max_backups} rotated files.
#      bench-results-sync copies them to the results volume after each test (never during one)
#      and removes the copied rotated files; if no copy happens for a long time, the oldest
#      local files are dropped instead of filling the disk.
extensions:
  health_check:
    endpoint: 127.0.0.1:13133

receivers:
  hostmetrics:
    collection_interval: ${interval_s}s
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      load: {}
      disk: {}
      network: {}
      paging: {}
  otlp:
    protocols:
      http:
        endpoint: 127.0.0.1:4318

processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: ${memory_limit_mib}
  resource:
    attributes:
%{ for k, v in resource_attributes ~}
      - key: ${k}
        value: "${v}"
        action: upsert
%{ endfor ~}
  batch:
    timeout: ${flush_s}s

exporters:
  file:
    path: ${path}
    format: json
    rotation:
      max_megabytes: ${rotate_mib}
      max_days: 0
      max_backups: ${max_backups} # local budget: ${max_backups} x ${rotate_mib} MiB
      localtime: false

service:
  extensions: [health_check]
  pipelines:
    metrics:
      receivers: [hostmetrics, otlp]
      processors: [memory_limiter, resource, batch]
      exporters: [file]
  telemetry:
    logs:
      level: warn
