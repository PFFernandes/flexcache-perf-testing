# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Keep .terraform.lock.hcl files committed (they pin provider versions).

# --- Local, environment-specific config (commit the *.example files instead) ---
*.tfvars
*.tfvars.json
*.tfvars.bak

# --- Benchmark output ---
# Local results folder at the repository root only (bench/results/ is code).
/results/

# --- OS / editor ---
.DS_Store
.vscode/*
!.vscode/extensions.json

# --- Secrets and private keys (never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# --- Python ---
__pycache__/
*.pyc
