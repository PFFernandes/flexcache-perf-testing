# Copy to common.tfvars (git-ignored). tf.sh passes it to every stack.

project = "flexcache-perf"
creator = "pedro" # Creator tag on every AWS resource and start of every Name: <creator>-<project>-...

# Origin and cache can be the same region (in-region test) or different regions
# (cross-region test, e.g. measure FlexCache over real WAN latency).
origin_region = "eu-west-1"
cache_region  = "eu-west-1"

# What to deploy: Origin only, Cache only, or both (FlexCache needs both).
# Used by 01-landing-zone (networks; peering only when both), 02-fsxn (FSx for ONTAP)
# and 03-ec2 (clients).
deploy_origin = true
deploy_cache  = true

# File protocol of the whole lab:
#   "nfs" (default): Linux clients mount NFS.
#   "smb": AWS Managed Microsoft AD in the origin VPC (01-landing-zone), SVMs joined to it
#          (02-fsxn), Windows clients (03-ec2) and the shares Origin and Cache (04-flexcache).
# Pick it before the first apply: switching later rebuilds the SVMs, volumes and clients.
protocol = "nfs"

# Availability Zones, as letters appended to the region ("a" = eu-west-1a).
# One private subnet is created per AZ. Single-AZ FSx for ONTAP uses the first;
# Multi-AZ needs two, e.g. ["a", "b"].
origin_azs = ["a"]
cache_azs  = ["a"]
